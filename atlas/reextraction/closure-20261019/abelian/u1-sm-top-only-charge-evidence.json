  "claims": [
    {
      "id": "p15-baseline",
      "basis": "source_statement",
      "locator": {
        "pdf_pages": [
          5
        ],
        "section": "Section2"
      },
      "fact": "Full GSM×U1F algebra and three copies of Q,L,eR,uR,dR; the selected SM (not SMνR) assignment has no added singlet neutrinos. Higgs is source (1,2,-1/2)."
    },
    {
      "id": "p15-Eq4.2",
      "basis": "source_statement",
      "locator": {
        "pdf_pages": [
          20,
          21
        ],
        "section_equations": "Eq4.2 and the paragraph below Table5"
      },
      "fact": "Weak-basis families are Q=(0,-3,3),eR=(0,-3,3),uR=(0,-1,1),L=(0,-4,4),dR=(0,0,0), and one source Higgs has FH=+2. This is a defined minimal gauge-basis EFT; the later broken-Zprime and UV-Yukawa applications are conditional and not an asserted extra field inventory."
    },
    {
      "id": "p15-normalization",
      "basis": "mathematical_convention_derivation",
      "locator": {
        "source": "atlas/FIELD_CONTENT_CONVENTIONS.md"
      },
      "fact": "Set qY=6Y jointly, with all charges primitive across every fermion and scalar; conjugate RH fields on all gauge factors. Expand generation charge lists into individual rows. Source H has qY=-3,F=2; its canonical real-module representative is the full conjugate, qY=3,F=-2."
    }
  ],
