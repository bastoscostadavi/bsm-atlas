  "claims": [
    {
      "id": "p15-family-baseline",
      "basis": "source_statement",
      "locator": {
        "pdf_pages": [
          5,
          22,
          24
        ],
        "section_equations": "Section2,Sections5.1-5.2"
      },
      "fact": "The source specifies GSM×U1F, three SM chiral families plus three singlet RH neutrinos and one Higgs H with source Y=-1/2. All SM Yukawa couplings force universal Q,uR,dR,L,eR charges and fix FH via Eq5.2; RH-neutrino charges may remain family-dependent. No requirement to specify a neutrino mass mechanism is imposed on the gauge-matter inventory."
    },
    {
      "id": "p15-family-polynomials",
      "basis": "source_equations_and_explicit_parameter_change",
      "locator": {
        "pdf_pages": [
          9,
          22,
          24
        ],
        "section_equations": "Eq3.1;Eqs5.1-5.3;source cubic Eq2.6"
      },
      "fact": "Define q=FQ, r=(Fn1+Fn2+Fn3)/3. Eq3.1 with universal SM species gives Fu=4q+r,Fd=-2q-r,FL=-3q,Fe=-6q-r;Eq5.2 gives FH=-3q-r. With ni=Fνi, the source conditions are sum ni=3r and sum ni^3=3r^3; these are source-family relations, not a new atlas anomaly gate. RHS ν_i become LH conjugates with X=-ni. The universal QYBL subfamily sets all ni=r; r!=0 retains the nonzero B-L component of P13 Eq45. Positive-Y atlas Higgs is the full scalar conjugate; no extra Higgs is added."
    },
    {
      "id": "p15-source-misprint",
      "basis": "source_conflict_recorded",
      "locator": {
        "pdf_pages": [
          9,
          22
        ],
        "section_equations": "Eq3.2 compared with Eq3.1 and Section5 Yukawa relations"
      },
      "fact": "The rendered Eq3.2 prints Fe=FQ-Fu, inconsistent with Eq3.1 and the charged-lepton Yukawa relation. Use the unambiguous Eq3.1 sum relation Fe=-6q-r and retain this visible source discrepancy; do not silently trust the text extraction."
    }
  ],
