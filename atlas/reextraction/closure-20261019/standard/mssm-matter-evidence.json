  "claims": [
    {
      "id": "baseline",
      "basis": "declared_atlas_baseline",
      "locator": {
        "file": "atlas/FIELD_CONTENT_CONVENTIONS.md",
        "section": "explicit F_SM/R_SM/R_MSSM templates"
      },
      "value": "Source-explicit SM/MSSM inheritance is expanded using the declared atlas baseline: three ordinary SM chiral families, no independent RH neutrino unless stated. Exact Dynkin and all-LH conversion are conventions/derivations, not newly printed source tables. Gauge connections and dependent conjugates are not extra matter."
    },
    {
      "id": "mssm",
      "basis": "source_statement",
      "locator": {
        "section_equations": "Tables1.1,1.2 and adjacent field definitions",
        "pdf_pages": [
          9
        ],
        "anchor": "spin-0 fields are complex"
      },
      "value": "Source explicitly tabulates three-family MSSM chiral supermultiplets; scalars complex and fermions LH Weyl. Hu,Hd Y=+/-1/2; gauge supermultiplets are adjoint gluino/wino/bino. Expand into independent scalar/Weyl rows, no auxiliary F and no double conjugation."
    },
    {
      "id": "messengers",
      "basis": "source_statement",
      "locator": {
        "section_equations": "Section7.7 Eqs.(7.7.1)-(7.7.2)",
        "pdf_pages": [
          88
        ],
        "anchor": "Wbreaking"
      },
      "value": "Minimal visible messenger example contains q+barq and l+barl chiral supermultiplets plus singlet S; source explicitly parameterizes an otherwise unspecified Wbreaking. It is not a complete hidden-sector theory."
    },
    {
      "id": "fresh-mssm",
      "locator": "P21 Tables1.1/1.2 PDFpp9-10; P22 AppendixA Eqs.(A.1)-(A.2) PDFpp227-228",
      "fact": "Three families Q,u^c,d^c,L,e^c; two Higgs chiral multiplets Hu,Hd with Y=+1/2,-1/2; adjoint gluino,wino,bino. P21 explicitly calls all chiral scalars complex and fermions LH Weyl. Both sources define gauge su3+su2+u1; RPV does not introduce additional matter. No auxiliary fields or repeated conjugate containers.",
      "basis": "fresh_source_tables_and_conventions"
    }
  ],
  "limitations": [
    "Full gauge-matter content, not the UV supersymmetry-breaking sector or all possible superpotential choices."
  ],
