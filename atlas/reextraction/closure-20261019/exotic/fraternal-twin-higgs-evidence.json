    {
      "id": "scalars",
      "locator": "PDF pp.9-11 Section II.A, Eqs. (1)-(4)",
      "fact": "One complex H=(A,B) with A the ordinary SM Higgs and B one twin weak doublet. The paper explicitly keeps the radial mode rather than choosing its nonlinear alternative. B is SM neutral; its neutral twin weak doublet is pseudoreal, so one source complex B is one underlying real module.",
      "basis": "source_statement_and_real_module_derivation"
    },
    {
      "id": "twin-gauge",
      "locator": "PDF pp.12-13 Section II.B; p.14 Section II.C items3-4",
      "fact": "Twin su(2) and su(3) are gauged. Twin hypercharge is explicitly not included in the minimal model. The complete algebra is g_SM plus twin su(3) plus twin su(2), not a dark-sector-only algebra.",
      "basis": "source_statement"
    },
    {
      "id": "twin-fermions",
      "locator": "PDF p.10 Eq. (2); p.14 Eqs. (9)-(10); pp.14-15 Section II.C items2,5,6",
      "fact": "Exactly one twin LH quark doublet, twin RH top and bottom, twin LH lepton doublet and twin RH tau, with no first/second twin generations. The three a labels on p.10 become the dimension of twin colour after gauging, not three copies of the triplet. The twin neutrino is the component of Lhat, not an added singlet. RH fields convert to LH conjugates across all factors.",
      "basis": "source_statement_and_LH_basis_conversion"
    },
    {
      "id": "SM-inheritance",
      "locator": "PDF pp.9-10 Section II.A; Atlas R_SM template",
      "fact": "Retain full ordinary three-family SM and one Higgs doublet. Twin fields are SM singlets, so source SM hypercharge converts jointly to q=6Y.",
      "basis": "source_explicit_inheritance_and_declared_atlas_baseline"
    }
  ],
