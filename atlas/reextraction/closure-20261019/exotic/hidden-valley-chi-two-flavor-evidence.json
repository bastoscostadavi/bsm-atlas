  "claims": [
    {
      "id": "table-inventory",
      "locator": "PDF p.1 Simple v-Model and Table I",
      "fact": "Full SM plus su(n_v) and u(1)_chi. Two hidden flavours U,Ubar and C,Cbar are fundamental/antifundamental; exactly three neutrino singlets N_i and one charged complex phi. All SM fields are valley neutral. Table uses common LH chiral coordinates q,ubar,dbar,L,eplus; N=-1 is interpreted in that same chiral coordinate, with source prose right-handed-species naming retained.",
      "basis": "source_table_and_common_chiral_coordinate_interpretation"
    },
    {
      "id": "fixed-benchmark",
      "locator": "PDF p.2 below Eq. (3)",
      "fact": "The paper explicitly uses n_v=3, kinetic mixing k=0, q_+=-2. The Table I relation q_++q_-=-2 gives q_-=0. Thus U,Ubar,C,Cbar charges are -2,0,+2,0. This numerical benchmark is not a replacement for the entire free-rank/free-charge family.",
      "basis": "source_statement_and_exact_substitution"
    },
    {
      "id": "normalization",
      "locator": "PDF p.1 Table I; Atlas full-inventory convention",
      "fact": "Multiply source hypercharge by6 and chi charge by5 jointly over the complete spectrum. Standard family chi charges become (-1,-1,3,3,-1); N=-5, H=2, phi=10, hidden flavour charges (-10,0,10,0). Three ordinary SM families are inherited; the source independently fixes exactly three N_i.",
      "basis": "mathematical_normalization_and_declared_SM_baseline"
    },
    {
      "id": "regime",
      "locator": "PDF pp.1-2 Table I and 2LF/1LF discussion; pp.4-5 Other Models",
      "fact": "Retain independent microscopic quarks, not dependent confined hadrons as additional matter. Coloured-X frameworks on pp.4-5 are separate alternatives, not appended to Table I.",
      "basis": "description_regime_selection"
    }
  ],
