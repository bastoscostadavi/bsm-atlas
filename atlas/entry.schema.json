{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://davibc.com/bsm-atlas/entry.schema.json",
  "title":"BSM field-content candidate",
  "description":"One fixed description regime with a complete declared inventory. Names and papers do not determine identity. Stored 4D Weyl fields are all left-handed; the checker also converts explicit RH/Dirac inputs before comparison.",
  "type":"object",
  "required":["schema_version","inventory_complete","gauge_factors","matter"],
  "properties":{
    "schema_version":{"const":"field-content-1"},
    "inventory_complete":{"const":true},
    "name":{"type":"string"},
    "paper_ids":{"type":"array","items":{"type":"string"}},
    "gauge_factors":{"type":"array","minItems":1,"items":{"type":"object","required":["id","family","rank"],"properties":{"id":{"type":"string","minLength":1},"family":{"enum":["A","B","C","D","E","F","G","U1"]},"rank":{"type":"integer","minimum":1}},"additionalProperties":false}},
    "matter":{"type":"array","minItems":1,"items":{"type":"object","required":["lorentz","reality","copies","gauge_representations"],"properties":{
      "label":{"type":"string"},
      "lorentz":{"type":"object","required":["dimension","scheme","irreps"],"properties":{"dimension":{"type":"integer","minimum":4},"scheme":{"type":"string"},"irreps":{"type":"array","minItems":1,"items":{"type":"array","minItems":1,"items":{"type":["string","integer"]}}}},"additionalProperties":false},
      "reality":{"enum":["real","complex","none","majorana"]},
      "copies":{"type":"integer","minimum":1},
      "gauge_representations":{"type":"object","additionalProperties":{"oneOf":[{"type":"object","required":["dynkin"],"properties":{"dynkin":{"type":"array","items":{"type":"integer","minimum":0}}},"additionalProperties":false},{"type":"object","required":["charge"],"properties":{"charge":{"type":"string","pattern":"^[+-]?[0-9]+(/[1-9][0-9]*)?$"}},"additionalProperties":false}]}}
    },"additionalProperties":false}}
  },
  "additionalProperties":false
}
