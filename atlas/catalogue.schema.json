{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davibc.com/bsm-atlas/catalogue.schema.json",
  "title": "BSM Atlas source catalogue",
  "description": "Complete gauge–matter specifications, references and paper-backed model–problem links. Run catalogue.py for cross-reference and duplicate validation; scientific support requires source review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "papers", "entries", "problems", "model_problems"],
  "properties": {
    "schema_version": {"const": "bsm-atlas-4"},
    "papers": {"type": "array", "items": {"$ref": "#/$defs/paper"}},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "problems": {"type": "array", "items": {"$ref": "#/$defs/problem"}},
    "model_problems": {"type": "array", "items": {"$ref": "#/$defs/problem_link"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "problem": {
      "description": "A curated problem name and category; reuse existing targets rather than introducing synonyms.",
      "type": "object", "additionalProperties": false, "required": ["id", "name", "category"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "name": {"$ref": "#/$defs/text"},
        "category": {
          "enum": ["empirical", "structural", "reported_discrepancy"],
          "description": "Empirical: established phenomena not accounted for by the minimal SM. Structural: explanatory or naturalness questions, not established observational contradictions. Reported discrepancy: source-era anomaly fits without a current-status assessment. This category does not rank a result's quality."
        }
      }
    },
    "problem_link": {
      "description": "A positive model–problem link backed by the pinned paper. A demonstrated successful parameter region, benchmark or conditional analytic result is required; a candidate alone is insufficient. Presence means a qualifying demonstration is recorded; absence is not proof of impossibility. Source review is required; scientific details remain in the paper.",
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "problem_id", "paper_id"],
      "properties": {
        "model_id": {"$ref": "#/$defs/text"}, "problem_id": {"$ref": "#/$defs/text"},
        "paper_id": {"$ref": "#/$defs/text"}
      }
    },
    "paper": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "arxiv", "title", "authors"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "arxiv": {"$ref": "#/$defs/text"},
        "title": {"$ref": "#/$defs/text"}, "authors": {"$ref": "#/$defs/text"}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["paper_id"],
      "properties": {
        "paper_id": {"$ref": "#/$defs/text"},
        "locators": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "parameter_names": {"type": "object", "additionalProperties": {"$ref": "#/$defs/text"}}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "specification", "references"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "name": {"$ref": "#/$defs/text"},
        "specification": {
          "$ref": "entry.schema.json",
          "properties": {"name": false, "paper_ids": false}
        },
        "references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
        "aliases": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name"],
          "properties": {"id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}}
        }}
      }
    }
  }
}
