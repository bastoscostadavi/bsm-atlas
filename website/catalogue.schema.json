{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davibc.com/bsm-atlas/catalogue.schema.json",
  "title": "BSM Atlas source catalogue",
  "description": "Complete gauge–matter specifications, references and source-supported demonstrations of solutions. Run catalogue.py for cross-reference and duplicate validation; evidence requires source review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "papers", "entries", "problems", "entry_problems"],
  "properties": {
    "schema_version": {"const": "bsm-atlas-3"},
    "papers": {"type": "array", "items": {"$ref": "#/$defs/paper"}},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "problems": {"type": "array", "items": {"$ref": "#/$defs/problem"}},
    "entry_problems": {"type": "array", "items": {"$ref": "#/$defs/demonstration"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "problem": {
      "description": "A curated physical target with an explicit success criterion; reuse existing targets rather than introducing synonyms.",
      "type": "object", "additionalProperties": false, "required": ["id", "name", "description", "category"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "name": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"},
        "category": {
          "enum": ["empirical", "structural", "reported_discrepancy"],
          "description": "Empirical: established phenomena not accounted for by the minimal SM. Structural: explanatory or naturalness questions, not established observational contradictions. Reported discrepancy: source-era anomaly fits without a current-status assessment. This category does not rank a result's quality."
        }
      }
    },
    "demonstration": {
      "description": "A result demonstrated in the pinned paper for this exact entry. A successful calculated region, benchmark or conditional analytic result is required; a candidate or suggested mechanism alone is insufficient. Source review is required: schema validation cannot verify scientific support or current viability.",
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "problem_id", "paper_id", "locators", "result"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/text"}, "problem_id": {"$ref": "#/$defs/text"},
        "paper_id": {"$ref": "#/$defs/text"}, "result": {"$ref": "#/$defs/text"},
        "locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "paper": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "arxiv", "title", "authors"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "arxiv": {"$ref": "#/$defs/text"},
        "title": {"$ref": "#/$defs/text"}, "authors": {"$ref": "#/$defs/text"}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["paper_id"],
      "properties": {
        "paper_id": {"$ref": "#/$defs/text"},
        "locators": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "parameter_names": {"type": "object", "additionalProperties": {"$ref": "#/$defs/text"}}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "specification", "references"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "name": {"$ref": "#/$defs/text"},
        "specification": {
          "$ref": "entry.schema.json",
          "properties": {"name": false, "paper_ids": false}
        },
        "references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
        "aliases": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name"],
          "properties": {"id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}}
        }}
      }
    }
  }
}
